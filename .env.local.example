# Site auth — copy to .env.local (gitignored) for local development.
# In production, set these as Vercel project environment variables.

# What visitors type at /login. Pick something memorable to share with
# interviewers; rotate by updating this var on Vercel.
SITE_PASSWORD=change-me-locally

# Server-side signing key for the session cookie HMAC. Any random
# 32+ char string. Rotating this invalidates all live sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITE_SECRET=change-me-locally-must-be-at-least-32-chars-long-random
